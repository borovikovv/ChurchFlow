# API and migrator runtime. Do not pass this file to the web service.
DATABASE_URL=postgresql://churchflow:<password>@churchflow-postgres:5432/churchflow?schema=public
WEB_APP_URL=https://stage.mychurchflow.org
COOKIE_DOMAIN=.mychurchflow.org
PLATFORM_ADMIN_EMAIL=admin@example.com
TELEGRAM_CLIENT_ID=<telegram-client-id>
TELEGRAM_CLIENT_SECRET=<telegram-client-secret>
TELEGRAM_REDIRECT_URI=https://api-stage.mychurchflow.org/v1/auth/telegram/callback
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_BOT_USERNAME=<telegram-bot-username>
TELEGRAM_WEBHOOK_SECRET=<telegram-webhook-secret>
TELEGRAM_WEBHOOK_URL=https://api-stage.mychurchflow.org/v1/telegram/webhook/<telegram-webhook-secret>
EMAIL_PROVIDER=resend
EMAIL_FROM="ChurchFlow <no-reply@mychurchflow.org>"
RESEND_API_KEY=<resend-api-key>
SMTP_HOST=
SMTP_PORT=
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_REFRESH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_REFRESH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=churchflow-stage
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
