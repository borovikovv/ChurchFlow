# Deployment metadata. IMAGE_TAG is scoped by environment to avoid tag collisions
# when stage and prod build the same commit with different build-time settings.
DEPLOY_ENV=stage
COMMIT_SHA=<commit-sha>
IMAGE_TAG=stage-<commit-sha>
API_IMAGE=ghcr.io/<owner>/churchflow-api:stage-<commit-sha>
MIGRATOR_IMAGE=ghcr.io/<owner>/churchflow-api-migrator:stage-<commit-sha>
WEB_IMAGE=ghcr.io/<owner>/churchflow-web:stage-<commit-sha>
TELEGRAM_CLIENT_ID=<telegram-client-id>

# Host binding. Keep BIND_ADDRESS on localhost because Caddy terminates TLS on the host.
BIND_ADDRESS=127.0.0.1
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# Shared Docker network used by app containers and the existing churchflow-postgres container.
INTERNAL_NETWORK=churchflow-internal
API_CONTAINER_NAME=churchflow-stage-api
WEB_CONTAINER_NAME=churchflow-stage-web
API_NETWORK_ALIAS=churchflow-stage-api
WEB_NETWORK_ALIAS=churchflow-stage-web
MIGRATOR_NETWORK_ALIAS=churchflow-stage-migrator
