# Local API for the mobile end-to-end tests. Every value here is a throwaway: the database,
# the mail sink and the storage are local, and nothing reaches a real provider.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://churchflow:churchflow@127.0.0.1:5432/churchflow?schema=public
WEB_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/v1
PLATFORM_ADMIN_EMAIL=admin@e2e.churchflow.test
EMAIL_PROVIDER=smtp
EMAIL_FROM="ChurchFlow E2E <noreply@e2e.churchflow.test>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_BUCKET=churchflow-e2e
S3_ACCESS_KEY_ID=e2e
S3_SECRET_ACCESS_KEY=e2e-secret
AI_ASSISTANT_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
