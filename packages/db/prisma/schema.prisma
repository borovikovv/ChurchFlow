generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  telegram
}

enum InvitationTargetProvider {
  telegram
  email
  phone
  google
  apple
}

enum InvitationMode {
  targeted_telegram
  claimable_link
}

enum SessionType {
  user
  service
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  REMOVED
}

enum MembershipSource {
  EXISTING
  MANUAL
  INVITATION
  ORGANIZATION_APPROVAL
}

enum MembershipClaimStatus {
  PENDING
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum OrganizationMemberRelationshipType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  OTHER
}

enum OrganizationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebsiteSectionType {
  hero
  about
  schedule
  gallery
  contact
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  INVITE
  LOGIN
  LOGOUT
  PUBLISH
  UNPUBLISH
}

enum FeatureFlagScope {
  GLOBAL
  ORGANIZATION
  USER
}

enum CalendarEventType {
  BIRTHDAY
  ANNIVERSARY
  TASK
  EVENT
  SERVICE
}

enum CalendarEventReminder {
  ONE_HOUR
  ONE_DAY
  ONE_WEEK
}

enum CalendarEventRepeatPeriod {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CalendarServiceRole {
  PREACHER
  SERVICE_HOST
  WORSHIP_LEAD
  COMMUNION_LEAD
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_DUE_REMINDER
  CALENDAR_EVENT_LINKED
  CALENDAR_EVENT_REMINDER
  SERVICE_ASSIGNED
  SERVICE_REMINDER
  MEMBER_ADDED
  MEMBER_REMOVED
  ORGANIZATION_REQUEST_CREATED
  PRAYER_REQUEST_CREATED
  BIRTHDAY_DIGEST
  ORGANIZATION_ANNOUNCEMENT
}

enum BudgetGroup {
  INCOME
  CURRENCY_EXCHANGE
  FACILITY
  TABLES
  PASTORS
  DISCIPLESHIP
  EVANGELISM
  OTHER
}

enum BudgetCategoryType {
  INCOME
  EXPENSE
}

enum BudgetEntryField {
  AMOUNT_UAH
  AMOUNT_USD
  AMOUNT_EUR
}

enum MemberMinistry {
  PREACHING
  WORSHIP
  DEACON
  MINISTER
  TEACHER
  MISSIONARY
  EVANGELIST
  CHAPLAIN
  CHILDREN
  YOUTH
}

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String?      @unique @db.Citext
  displayName       String?
  avatarUrl         String?
  baptizedAt        DateTime?    @map("baptized_at") @db.Date
  baptismChurchName String?      @map("baptism_church_name")
  locale            String       @default("en") @db.VarChar(5)
  emailVerified     DateTime?
  platformRole      PlatformRole @default(USER) @map("platform_role")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  accounts                        AuthAccount[]
  sessions                        Session[]
  memberships                     OrganizationMember[]
  createdMemberships              OrganizationMember[]            @relation("MembershipCreator")
  requestedMembershipClaims       MembershipClaim[]               @relation("MembershipClaimRequester")
  reviewedMembershipClaims        MembershipClaim[]               @relation("MembershipClaimReviewer")
  createdMembershipClaims         MembershipClaim[]               @relation("MembershipClaimCreator")
  invitations                     OrganizationInvitation[]        @relation("InvitationInviter")
  reviewedOrganizationRequests    OrganizationRequest[]           @relation("OrganizationRequestReviewer")
  requestedOrganizationRequests   OrganizationRequest[]           @relation("OrganizationRequestRequester")
  claimedInvitations              OrganizationInvitation[]        @relation("InvitationClaimer")
  consumedPlatformAdminBootstraps PlatformAdminBootstrapToken[]
  auditLogs                       AuditLog[]
  featureFlags                    FeatureFlag[]
  createdCalendarEvents           CalendarEvent[]                 @relation("CalendarEventCreator")
  calendarPreferences             CalendarPreference[]
  authoredPrayerRequests          PrayerRequest[]                 @relation("PrayerRequestAuthor")
  archivedPrayerRequests          PrayerRequest[]                 @relation("PrayerRequestArchiver")
  notifications                   Notification[]                  @relation("NotificationRecipient")
  notificationPreferences         NotificationPreference[]
  telegramNotificationBinding     TelegramNotificationBinding?
  telegramNotificationLinkTokens  TelegramNotificationLinkToken[]

  @@map("users")
}

model PlatformAdminBootstrapToken {
  id               String    @id @default(uuid()) @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  consumedByUserId String?   @map("consumed_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  consumedBy User? @relation(fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([consumedByUserId])
  @@map("platform_admin_bootstrap_tokens")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  credentialId      String?      @map("credential_id")
  publicKey         String?      @map("public_key")
  metadata          Json         @default("{}")
  lastUsedAt        DateTime?    @map("last_used_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, credentialId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  type             SessionType @default(user)
  refreshTokenHash String      @map("refresh_token_hash")
  userAgent        String?     @map("user_agent")
  ipAddress        String?     @map("ip_address")
  expiresAt        DateTime    @map("expires_at")
  revokedAt        DateTime?   @map("revoked_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  status      OrganizationStatus @default(ACTIVE)
  archivedAt  DateTime?          @map("archived_at")
  suspendedAt DateTime?          @map("suspended_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  members                 OrganizationMember[]
  invitations             OrganizationInvitation[]
  website                 OrganizationWebsite?
  mediaAssets             MediaAsset[]
  auditLogs               AuditLog[]
  featureFlags            FeatureFlag[]
  requests                OrganizationRequest[]
  memberRelationships     OrganizationMemberRelationship[]
  calendarEvents          CalendarEvent[]
  calendarPreferences     CalendarPreference[]
  memberMinistries        OrganizationMemberMinistry[]
  preacherQueue           PreacherQueueEntry[]
  calendarServices        CalendarServiceDetails[]
  serviceParticipants     CalendarServiceParticipant[]
  serviceSongs            CalendarServiceSong[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  budgetCategories        BudgetCategory[]
  budgetMonths            BudgetMonth[]
  budgetOpeningBalances   BudgetOpeningBalance[]
  prayerRequests          PrayerRequest[]

  @@index([status])
  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  userId          String?                  @map("user_id") @db.Uuid
  role            OrganizationRole         @default(MEMBER)
  status          OrganizationMemberStatus @default(ACTIVE)
  source          MembershipSource         @default(EXISTING)
  createdByUserId String?                  @map("created_by_user_id") @db.Uuid
  claimedAt       DateTime?                @map("claimed_at")
  permissions     String[]                 @default([])
  joinedAt        DateTime                 @default(now()) @map("joined_at")
  archivedAt      DateTime?                @map("archived_at")
  removedAt       DateTime?                @map("removed_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization          Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?                            @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdBy             User?                            @relation("MembershipCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  profile               OrganizationMemberProfile?
  claims                MembershipClaim[]
  outgoingRelationships OrganizationMemberRelationship[] @relation("RelationshipFrom")
  incomingRelationships OrganizationMemberRelationship[] @relation("RelationshipTo")
  linkedCalendarEvents  CalendarEvent[]                  @relation("CalendarEventLinkedMember")
  assignedCalendarTasks CalendarEventAssignee[]
  serviceParticipants   CalendarServiceParticipant[]
  ministries            OrganizationMemberMinistry[]
  preacherQueueEntries  PreacherQueueEntry[]
  prayerRequests        PrayerRequest[]                  @relation("PrayerRequestMembershipAuthor")
  notifications         Notification[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
  @@index([organizationId, status])
  @@index([createdByUserId])
  @@index([organizationId, source])
  @@map("organization_members")
}

model OrganizationMemberProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  membershipId        String    @unique @map("membership_id") @db.Uuid
  displayName         String    @map("display_name")
  email               String?   @db.Citext
  phone               String?
  notes               String?
  memberSince         DateTime? @map("member_since") @db.Date
  birthday            DateTime? @db.Date
  anniversary         DateTime? @db.Date
  biography           String?
  familyNotes         String?   @map("family_notes")
  profilePhotoAssetId String?   @unique @map("profile_photo_asset_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  membership        OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  profilePhotoAsset MediaAsset?        @relation(fields: [profilePhotoAssetId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([phone])
  @@map("organization_member_profiles")
}

model OrganizationMemberRelationship {
  id               String                             @id @default(uuid()) @db.Uuid
  organizationId   String                             @map("organization_id") @db.Uuid
  fromMembershipId String                             @map("from_membership_id") @db.Uuid
  toMembershipId   String                             @map("to_membership_id") @db.Uuid
  type             OrganizationMemberRelationshipType
  notes            String?
  createdAt        DateTime                           @default(now()) @map("created_at")
  updatedAt        DateTime                           @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromMembership OrganizationMember @relation("RelationshipFrom", fields: [fromMembershipId], references: [id], onDelete: Cascade)
  toMembership   OrganizationMember @relation("RelationshipTo", fields: [toMembershipId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromMembershipId, toMembershipId, type], map: "organization_member_relationships_organization_id_from_membersh")
  @@index([organizationId, fromMembershipId], map: "member_relationships_from_idx")
  @@index([organizationId, toMembershipId], map: "member_relationships_to_idx")
  @@map("organization_member_relationships")
}

model OrganizationMemberMinistry {
  organizationId String         @map("organization_id") @db.Uuid
  membershipId   String         @map("membership_id") @db.Uuid
  ministry       MemberMinistry
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, ministry])
  @@index([organizationId, ministry])
  @@index([organizationId, membershipId], map: "organization_member_ministries_organization_id_membership_id_id")
  @@map("organization_member_ministries")
}

model MembershipClaim {
  id                String                @id @default(uuid()) @db.Uuid
  membershipId      String                @map("membership_id") @db.Uuid
  tokenHash         String                @unique @map("token_hash")
  status            MembershipClaimStatus @default(PENDING)
  expiresAt         DateTime              @map("expires_at")
  requestedAt       DateTime?             @map("requested_at")
  approvedAt        DateTime?             @map("approved_at")
  rejectedAt        DateTime?             @map("rejected_at")
  revokedAt         DateTime?             @map("revoked_at")
  requestedByUserId String?               @map("requested_by_user_id") @db.Uuid
  reviewedByUserId  String?               @map("reviewed_by_user_id") @db.Uuid
  provider          AuthProvider?
  providerAccountId String?               @map("provider_account_id")
  createdByUserId   String?               @map("created_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  membership  OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  requestedBy User?              @relation("MembershipClaimRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User?              @relation("MembershipClaimReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("MembershipClaimCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([membershipId, status])
  @@index([requestedByUserId])
  @@index([expiresAt])
  @@map("membership_claims")
}

model OrganizationInvitation {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationId          String                    @map("organization_id") @db.Uuid
  mode                    InvitationMode            @default(targeted_telegram)
  targetProvider          InvitationTargetProvider? @map("target_provider")
  targetProviderAccountId String?                   @map("target_provider_account_id")
  targetDisplay           String?                   @map("target_display")
  email                   String?                   @db.Citext
  role                    OrganizationRole          @default(MEMBER)
  permissions             String[]                  @default([])
  tokenHash               String                    @map("token_hash")
  status                  InvitationStatus          @default(PENDING)
  invitedByUserId         String?                   @map("invited_by_id") @db.Uuid
  claimedByUserId         String?                   @map("claimed_by_user_id") @db.Uuid
  claimedAt               DateTime?                 @map("claimed_at")
  expiresAt               DateTime                  @map("expires_at")
  acceptedAt              DateTime?                 @map("accepted_at")
  revokedAt               DateTime?                 @map("revoked_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  deletedAt               DateTime?                 @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  claimedBy    User?        @relation("InvitationClaimer", fields: [claimedByUserId], references: [id], onDelete: SetNull)

  @@unique([tokenHash])
  @@index([organizationId])
  @@index([email])
  @@index([targetProvider, targetProviderAccountId], map: "org_inv_target_lookup_idx")
  @@index([mode, status, expiresAt])
  @@index([claimedByUserId])
  @@index([expiresAt])
  @@index([organizationId, status])
  @@index([organizationId, targetProvider, targetProviderAccountId, status, expiresAt], map: "org_inv_target_status_exp_idx")
  @@map("organization_invitations")
}

model OrganizationRequest {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizationName        String                    @map("organization_name")
  organizationSlug        String?                   @map("organization_slug")
  contactName             String                    @map("contact_name")
  contactEmail            String?                   @map("contact_email") @db.Citext
  contactTelegramId       String?                   @map("contact_telegram_id")
  contactTelegramUsername String?                   @map("contact_telegram_username")
  contactPhone            String?                   @map("contact_phone")
  message                 String?
  status                  OrganizationRequestStatus @default(PENDING)
  approvedAt              DateTime?                 @map("approved_at")
  rejectedAt              DateTime?                 @map("rejected_at")
  reviewedByUserId        String?                   @map("reviewed_by_user_id") @db.Uuid
  requestedByUserId       String?                   @map("requested_by_user_id") @db.Uuid
  createdOrganizationId   String?                   @map("created_organization_id") @db.Uuid
  rejectionReason         String?                   @map("rejection_reason")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  reviewedBy          User?         @relation("OrganizationRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  requestedBy         User?         @relation("OrganizationRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  createdOrganization Organization? @relation(fields: [createdOrganizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactEmail])
  @@index([requestedByUserId])
  @@index([createdAt])
  @@map("organization_requests")
}

model OrganizationWebsite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @unique @map("organization_id") @db.Uuid
  title          String
  description    String?
  logoAssetId    String?   @map("logo_asset_id") @db.Uuid
  theme          Json      @default("{}")
  settings       Json      @default("{}")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        WebsitePage[]
  domains      WebsiteDomain[]

  @@index([organizationId])
  @@map("organization_websites")
}

model WebsitePage {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  websiteId      String     @map("website_id") @db.Uuid
  slug           String
  title          String
  status         PageStatus @default(DRAFT)
  seo            Json       @default("{}")
  publishedAt    DateTime?  @map("published_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  website  OrganizationWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sections WebsiteSection[]

  @@unique([websiteId, slug])
  @@index([organizationId, status])
  @@index([websiteId, status])
  @@map("website_pages")
}

model WebsiteSection {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  pageId         String             @map("page_id") @db.Uuid
  type           WebsiteSectionType
  order          Int                @default(0)
  content        Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([pageId, order])
  @@map("website_sections")
}

model WebsiteDomain {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  websiteId      String    @map("website_id") @db.Uuid
  hostname       String    @unique
  isPrimary      Boolean   @default(false) @map("is_primary")
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  website OrganizationWebsite @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([websiteId])
  @@map("website_domains")
}

model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  bucket         String
  objectKey      String    @map("object_key")
  filename       String
  mimeType       String    @map("mime_type")
  byteSize       BigInt    @map("byte_size")
  width          Int?
  height         Int?
  altText        String?   @map("alt_text")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberProfile  OrganizationMemberProfile?
  calendarEvents CalendarEvent[]

  @@unique([bucket, objectKey])
  @@index([organizationId, createdAt])
  @@map("media_assets")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt, id])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model CalendarEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  createdByUserId    String?                   @map("created_by_user_id") @db.Uuid
  linkedMembershipId String?                   @map("linked_membership_id") @db.Uuid
  imageAssetId       String?                   @map("image_asset_id") @db.Uuid
  type               CalendarEventType
  title              String
  description        String?
  startsAt           DateTime                  @map("starts_at")
  endsAt             DateTime?                 @map("ends_at")
  allDay             Boolean                   @default(false) @map("all_day")
  reminder           CalendarEventReminder?
  repeatPeriod       CalendarEventRepeatPeriod @default(NONE) @map("repeat_period")
  taskCompleted      Boolean                   @default(false) @map("task_completed")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User?                   @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  linkedMembership OrganizationMember?     @relation("CalendarEventLinkedMember", fields: [linkedMembershipId], references: [id], onDelete: SetNull)
  imageAsset       MediaAsset?             @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  assignees        CalendarEventAssignee[]
  serviceDetails   CalendarServiceDetails?

  @@index([organizationId, startsAt])
  @@index([organizationId, type, startsAt])
  @@index([organizationId, deletedAt])
  @@index([linkedMembershipId])
  @@index([imageAssetId])
  @@map("calendar_events")
}

model CalendarServiceDetails {
  eventId        String   @id @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  hasCommunion   Boolean  @default(false) @map("has_communion")
  biblePassage   String?  @map("bible_passage")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  event        CalendarEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants CalendarServiceParticipant[]
  songs        CalendarServiceSong[]

  @@index([organizationId])
  @@map("calendar_service_details")
}

model CalendarServiceParticipant {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  eventId             String              @map("event_id") @db.Uuid
  role                CalendarServiceRole
  membershipId        String?             @map("membership_id") @db.Uuid
  customName          String?             @map("custom_name")
  displayNameSnapshot String?             @map("display_name_snapshot")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        CalendarServiceDetails @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  membership   OrganizationMember?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([eventId, role])
  @@index([organizationId, role])
  @@index([membershipId])
  @@map("calendar_service_participants")
}

