  updatedAt DateTime         @updatedAt @map("updated_at")

  entry BudgetEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, field])
  @@index([entryId])
  @@map("budget_entry_notes")
}

